# HTCondor submit description for ggHH_SMEFT gridpacks — one job per parameter point.
# Conventions mirror genproductions bin/Powheg/run_pwg_condor.py
# (+JobFlavour, MY.WantOS, getenv, periodic_remove, WhenToTransferOutput).
#
# Submit with the driver:  ./submit_smeft.sh   (it fills the variables below and
# generates cards.list).  You can also override on the CLI:
#   condor_submit submit_smeft.sub -a 'PROCESS_TARBALL=...' -a 'OUTPUT_DIR=...'

universe                = vanilla
executable              = run_smeft_gridpack.sh

# The per-point card is the queue variable; ship it to the node, pass its basename.
arguments               = $Fnx(card)
transfer_input_files    = $(card)
should_transfer_files   = YES
# ON_EXIT (not ON_EXIT_OR_EVICT): the job delivers its gridpack to EOS itself, so
# there is nothing to hand back on eviction. ON_EXIT_OR_EVICT tried to spool output
# on every eviction and FAILED (hold Code 13) -> the job was then auto-removed.
# With ON_EXIT an evicted job simply requeues and re-runs instead of being held.
WhenToTransferOutput    = ON_EXIT
transfer_output_files   = ""

# Runtime configuration handed to run_smeft_gridpack.sh. ALL vars the job needs are
# passed EXPLICITLY here (INCLUDE_BINARY, LCG_VIEW, NCORES, NXGRID, OUTPUT_DIR,
# PROCESS_TARBALL, TESTMODE), so the job does NOT inherit the submitter's shell.
environment             = "PROCESS_TARBALL=$(PROCESS_TARBALL) OUTPUT_DIR=$(OUTPUT_DIR) NCORES=$(NCORES) NXGRID=$(NXGRID) INCLUDE_BINARY=$(INCLUDE_BINARY) TESTMODE=$(TESTMODE) LCG_VIEW=$(LCG_VIEW)"
# Clean environment (airtight for third parties): getenv False = do not copy the
# submit shell's env into the job. The grid proxy for EOS xrdcp is delivered properly
# by use_x509userproxy (the file is transferred + X509_USER_PROXY set on the worker),
# not inherited via getenv. Mirrors submit_nanogen.sub.
getenv                  = False
use_x509userproxy       = True

# Resources — request_cpus MUST equal NCORES.
# TODO: tune request_memory / +JobFlavour from the single-point timing test.
request_cpus            = $(NCORES)
request_memory          = 2500M
request_disk            = 4GB

# OS container selection on lxplus (el9 matches the LCG_107/el9 build).
MY.WantOS               = "el9"

# Refuse the pool's slow silicon. Measured over 615 completed builds: hosts with
# KFlops < 3M ran a median 100.7h vs 55.1h on KFlops >= 3M -- a 2.2x swing from
# HARDWARE, not physics (the SAME point rebuilt varies up to 1.6x, and no Wilson
# coefficient predicts cost: strongest |rho| is 0.28 for CH). That slow tail is what
# blows the 72h testmatch wall: builds over 72h drop 20.3% -> 3.7% with this cut,
# while ~10.4k of 13.9k candidate 4-core slots (75%) remain. >=4M/5M buys nothing
# and costs slots, so 3M is the knee. KFlops is defined on 82352/82353 pool slots,
# so this excludes essentially nothing by accident.
# NOTE: the CERN schedd rewrites Requirements -- it MOVES this expression into
# PreVerRequirements and wraps its own Hostgroup/AFS/CVMFS/OpSysAndVer chain around
# it. So the top-level `Requirements` you see in condor_q will NOT show this clause;
# check `condor_q -af PreVerRequirements`. It is applied, just relocated.
Requirements            = (TARGET.KFlops >= 3000000)

# Wall-clock budget. lxplus flavours: espresso(20m) microcentury(1h) longlunch(2h)
# workday(8h) tomorrow(1d) testmatch(3d) nextweek(1w). A production point is ~52h, so
# testmatch(72h) fits with ~20h margin. Do NOT go back to nextweek: the workers are in a
# staged drain and only start a job if (time() + MaxRuntime < ShutdownTime), so a 7-day
# job matches ~75 slots pool-wide vs ~279 for 72h. (The driver -appends this too.)
+JobFlavour             = "testmatch"

# Per-job logs (keep in a logs/ subdir).
output                  = logs/$(point).$(ClusterId).$(ProcId).out
error                   = logs/$(point).$(ClusterId).$(ProcId).err
log                     = logs/smeft.$(ClusterId).log

# Hold handling: recover transient holds instead of deleting them (a held job used
# to be removed on the spot, silently losing points).
#  - periodic_release: retry a hold that is NOT a user condor_hold (HoldReasonCode
#    1), after a 10-min backoff, up to 5 restarts. Evictions/transfer blips self-heal.
#  - periodic_remove: give up only when a job cannot make progress — held > 1h
#    (never released) or restarted too many times. Real failures still get dropped.
periodic_release        = (JobStatus == 5) && (HoldReasonCode =!= 1) \
                          && (NumJobStarts <= 5) \
                          && ((time() - EnteredCurrentStatus) > 600)
#  - the NumJobStarts clause below is the WALL-LOOP BACKSTOP. A job killed at the
#    testmatch wall is EVICTED, not held, so the hold rules above never see it: it
#    just requeues and re-runs from zero (no checkpointing) forever, burning 72h a
#    cycle. Even with the KFlops cut ~3.7% of builds still exceed 72h (max observed
#    154.5h). Removing them after 4 starts makes the loop terminate: they then show
#    up as missing in `--report` and can be resubmitted with `--only-missing
#    --flavour nextweek`. Gated on JobStatus==1 so we only drop a job that has
#    already failed and is waiting to retry -- never one mid-run. Threshold 4 (not
#    2) because the staged drain evicts healthy jobs too, and those deserve retries.
periodic_remove         = ( (JobStatus == 5) && \
                          ( (time() - EnteredCurrentStatus) > 3600 || NumJobStarts > 5 ) ) || \
                          ( (JobStatus == 1) && (NumJobStarts > 3) )
# Throttle how many jobs materialize at once (protects the schedd for 2500 points).
max_materialize         = 200

# Queue one job per card listed in cards.list; expose a short tag as $(point).
queue point,card from cards.list
